# Allow this repository's branch and draft pull-request workflow.
# Repository instructions require requested-path staging and staged-path review.

prefix_rule(
    pattern = ["git", "ls-remote", "--exit-code", "--heads", "origin"],
    decision = "allow",
    justification = "Confirm the current branch still exists upstream",
    match = [
        "git ls-remote --exit-code --heads origin chore/tighten-workflow",
    ],
    not_match = [
        "git fetch origin main",
        "git push",
    ],
)

prefix_rule(
    pattern = ["git", "fetch", "origin", "main"],
    decision = "allow",
    justification = "Refresh origin/main before creating a task branch",
    match = ["git fetch origin main"],
    not_match = [
        "git fetch --all",
        "git pull",
    ],
)

prefix_rule(
    pattern = ["git", "switch", "-c"],
    decision = "allow",
    justification = "Create a fitting task branch",
    match = ["git switch -c chore/tighten-workflow origin/main"],
    not_match = [
        "git switch main",
        "git checkout -- README.md",
    ],
)

prefix_rule(
    pattern = ["git", "add", "--"],
    decision = "allow",
    justification = "Stage explicitly named requested paths",
    match = [
        "git add -- AGENTS.md",
        "git add -- README.md scripts/install.sh",
    ],
    not_match = [
        "git add .",
        "git add -A",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "-m"],
    decision = "allow",
    justification = "Commit the verified requested change",
    match = ["git commit -m Tighten workflow"],
    not_match = [
        "git commit --amend",
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", "push", "-u", "origin", "HEAD"],
    decision = "allow",
    justification = "Push the verified task branch",
    match = ["git push -u origin HEAD"],
    not_match = [
        "git push",
        "git push --force",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create", "--fill", "--draft"],
    decision = "allow",
    justification = "Open the validated change as a draft pull request",
    match = ["gh pr create --fill --draft"],
    not_match = [
        "gh pr merge",
        "gh repo delete",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "checks"]],
    decision = "allow",
    justification = "Report the created pull request and its checks",
    match = [
        "gh pr view --json number,url",
        "gh pr checks",
    ],
    not_match = [
        "gh pr merge",
        "gh pr close",
    ],
)
