# Reduce approval prompts for read-only branch and pull-request inspection.
# Mutation commands remain unmatched because prefix rules cannot reject risky
# trailing arguments. These rules do not grant authorization.

prefix_rule(
    pattern = ["git", "ls-remote", "--exit-code", "--heads", "origin"],
    decision = "allow",
    justification = "Confirm the current branch still exists upstream",
    match = [
        "git ls-remote --exit-code --heads origin chore/tighten-workflow",
    ],
    not_match = [
        "git fetch origin main",
        "git push",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "checks"]],
    decision = "allow",
    justification = "Inspect the current pull request and its checks",
    match = [
        "gh pr view --json number,url",
        "gh pr checks",
    ],
    not_match = [
        "gh pr merge",
        "gh pr close",
    ],
)
